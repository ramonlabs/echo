#!/usr/bin/env bash

BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICES=(tts llm stt avatar memory panel)

export PC_PORT_NUM=47106

start() {
    [ ! -f "$BASE/.pids/.setup" ] && echo "run ./echo setup first." && exit 1
    cd "$BASE"
    process-compose --config "$BASE/process-compose.yaml" up --detached
    echo "started. attach: ./echo attach   stop: ./echo stop"
}

stop()    { process-compose down; }
attach()  { process-compose attach; }
restart() { stop; start; }

setup() {
    git submodule update --init --recursive
    uv sync
    for name in "${SERVICES[@]}"; do
        [ -f "$BASE/services/$name/src/setup.py" ] && \
            ( cd "$BASE/services/$name/src" && python3 setup.py --no-venv )
    done
    mkdir -p "$BASE/.pids"
    touch "$BASE/.pids/.setup"
}

case "$1" in
    start)   start ;;
    attach)  attach ;;
    stop)    stop ;;
    restart) restart ;;
    setup)   setup ;;
    *)       echo "usage: ./echo start|attach|stop|restart|setup" ;;
esac
